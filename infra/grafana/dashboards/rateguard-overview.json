{
  "uid": "rateguard-overview",
  "title": "RateGuard — Overview",
  "tags": ["rateguard", "rate-limiting"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "tenant",
        "label": "Tenant",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
        "query": "label_values(rateguard_requests_total, tenant)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Allow vs Deny (req/s)",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (decision) (rate(rateguard_requests_total[1m]))",
          "legendFormat": "{{decision}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests by gateway replica (proof of distribution)",
      "description": "Three lines rising together is the visual form of the correctness proof: load really is spread across replicas sharing one limit.",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (replica) (rate(rateguard_requests_total[1m]))",
          "legendFormat": "{{replica}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Denied requests by tenant (top 10)",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10, sum by (tenant) (rate(rateguard_requests_total{decision=\"deny\", tenant=~\"$tenant\"}[1m])))",
          "legendFormat": "{{tenant}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Rate-limit decision latency (histogram estimate)",
      "description": "Bucket-interpolated. The authoritative client-observed p99 comes from load-test/throughput-test.js.",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] } },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(rateguard_decision_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(rateguard_decision_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(rateguard_decision_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Redis unavailable (5m)",
      "description": "Any non-zero value means enforcement was degraded (fail-open, frozen F5). This must be loud.",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(rateguard_redis_unavailable_total[5m]))",
          "legendFormat": "degraded decisions"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Deny rate (5m)",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.25 },
              { "color": "orange", "value": 0.6 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(rateguard_requests_total{decision=\"deny\"}[5m])) / clamp_min(sum(rate(rateguard_requests_total[5m])), 0.0001)",
          "legendFormat": "deny rate"
        }
      ]
    },
    {
      "id": 7,
      "type": "stat",
      "title": "Anomaly throttles (5m)",
      "datasource": { "type": "prometheus", "uid": "rateguard-prometheus" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 16 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(rateguard_anomaly_throttle_total[5m]))",
          "legendFormat": "throttled"
        }
      ]
    }
  ]
}