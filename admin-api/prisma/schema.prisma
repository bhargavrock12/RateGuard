generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id           String   @id @default(uuid()) @db.Uuid
  name         String
  apiKeyHash   String   @unique @map("api_key_hash")
  apiKeyPrefix String?  @map("api_key_prefix")
  plan         String   @default("free")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  policies  RateLimitPolicy[]
  usageLogs UsageLog[]

  @@map("tenants")
}

model RateLimitPolicy {
  id            String   @id @default(uuid()) @db.Uuid
  tenantId      String   @map("tenant_id") @db.Uuid
  routePattern  String   @map("route_pattern")
  algorithm     String
  limitCount    Int      @map("limit_count")
  windowSeconds Int?     @map("window_seconds")
  refillRate    Decimal? @map("refill_rate") @db.Decimal(12, 4)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, routePattern])
  @@index([tenantId])
  @@map("rate_limit_policies")
}

model UsageLog {
  id         BigInt   @id @default(autoincrement())
  tenantId   String?  @map("tenant_id") @db.Uuid
  route      String?
  allowed    Boolean?
  algorithm  String?
  reasonCode String?  @map("reason_code")
  latencyMs  Int?     @map("latency_ms")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@map("usage_logs")
}